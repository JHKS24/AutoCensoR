{
  "name": "AutoCensoR",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "files": [
    "AUTHORS.md",
    "AutoCensor.spec",
    "COPYRIGHT",
    "EN/",
    "KR/",
    "LICENSE",
    "NOTICE",
    "README.md",
    "SECURITY.md",
    "backend/",
    "docs/PRIVACY_RELEASE.md",
    "docs/SERVER_BACKEND.md",
    "docs/SHORTCUTS.md",
    "eslint.config.js",
    "index.html",
    "models/README.md",
    "package-lock.json",
    "public/",
    "requirements*.txt",
    "scripts/",
    "src/",
    "tsconfig*.json",
    "vite.config.ts"
  ],
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "backend": "powershell -ExecutionPolicy Bypass -File scripts/start_backend.ps1",
    "desktop": "python backend/autocensor_desktop.py",
    "desktop:build": "powershell -ExecutionPolicy Bypass -File scripts/build_desktop.ps1",
    "icon": "python scripts/generate_app_icon.py",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "playwright": "^1.60.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.1.0"
  }
}
